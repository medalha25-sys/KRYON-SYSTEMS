# URL da API do projeto Supabase (disponível em Project Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima do Supabase (anon / public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# URL pública da aplicação (Opcional - definida automaticamente pela Vercel)
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app
